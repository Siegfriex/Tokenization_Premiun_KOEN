htmlcov/

# Jupyter and local runtime
.ipynb_checkpoints/
.runtime/
.agent_worktrees/
.env

# Node
node_modules/
npm-debug.log*

# Research data and trained artifacts
data/[0-9][0-9][0-9].*/
data/raw/**
data/interim/**
data/processed/**
data/registry/**
models/**
artifacts/**
outputs/**
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/registry/.gitkeep
!models/.gitkeep
!outputs/manifests/
!outputs/manifests/**
!outputs/figures/
!outputs/figures/F00_*
!outputs/reports/
!outputs/reports/ENVIRONMENT_*
!outputs/reports/PAIR_REGISTRY_RECONCILIATION_*
!outputs/reports/LEGACY_REFERENCE_AUDIT_*
# G5 analysis-readiness reports: aggregate diagnostics only — no raw text, no pair_id,
# no token/chunk string. Required as G5 evidence by G5_DIAGNOSTIC_PROTOCOL_v001 §12.
!outputs/reports/G5_*
# NB07 canonical descriptive EDA reports and figures: aggregate diagnostics and
# sanitized figures only — no raw text, no pair_id, no token/chunk string.
!outputs/reports/NB07_*
!outputs/figures/nb07/
!outputs/figures/nb07/**
# Manual-audit evidence: allow ONLY the id/metadata sampling keys through.
# Everything else under outputs/manual_audit/ stays ignored by outputs/** above,
# because that directory also holds populated audit workbooks.
!outputs/manual_audit/
!outputs/manual_audit/*_SAMPLING_KEY_*.csv

# Human audit workbooks carry raw KO/EN sentence text and this repository is
# PUBLIC. The audit packs are declared "local only"; enforce that mechanically
# so a single `git add -A` cannot publish licensed source text. Verified to
# contain real sentences, not templates:
#   ssot/HumanLebeled/[HUMAN]_AUDIT_500_REJUDGED.xlsx
#   ssot/HumanLebeled/[HUMAN]_MORPHOLOGY_AUDIT_100_v001.xlsx
#   outputs/manual_audit/KOEN_MANUAL_AUDIT_500.xlsx
# Aggregate evidence belongs in outputs/manifests/ and the sampling keys.
*.xlsx
# Windows에서 복사된 파일에 붙는 NTFS alternate data stream 잔여물.
*:Zone.Identifier

# OS / editor
.DS_Store
Thumbs.db
